; fib.sasm - Fibonacci numbers, count from the first argument (default 20)
.include "synth.inc"

main:
    mov  r9, 20
    cmp  r1, 2
    jl   .start
    ld   r1, [r2 + 4]
    sys  atoi
    mov  r9, r0
.start:
    mov  r5, 0               ; a
    mov  r6, 1               ; b
    mov  r7, 0               ; i
.loop:
    cmp  r7, r9
    jge  .done
    mov  r1, r5
    sys  printi
    mov  r1, ' '
    sys  putc
    add  r8, r5, r6
    mov  r5, r6
    mov  r6, r8
    add  r7, r7, 1
    jmp  .loop
.done:
    mov  r1, '\n'
    sys  putc
    mov  r1, 0
    sys  exit
