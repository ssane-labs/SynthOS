#include <windows.h>

#define IDD_MAIN 100
#define IDC_NAME 101
#define IDC_LOUD 102
#define IDC_GREET 103
#define IDC_RESULT 104
#define IDS_TITLE 200
#define IDS_HELLO 201

STRINGTABLE
BEGIN
    IDS_TITLE "Greeter"
    IDS_HELLO "Hello from a string table"
END

IDD_MAIN DIALOGEX 0, 0, 220, 118
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Greeter"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Name:", -1, 10, 12, 40, 10
    EDITTEXT        IDC_NAME, 50, 9, 160, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Shout", IDC_LOUD, 50, 30, 80, 12
    PUSHBUTTON      "Greet", IDC_GREET, 50, 48, 70, 16
    LTEXT           "", IDC_RESULT, 10, 72, 200, 12
    DEFPUSHBUTTON   "OK", IDOK, 104, 94, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 160, 94, 50, 16
END
